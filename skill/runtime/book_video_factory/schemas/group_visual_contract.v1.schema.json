{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "group_visual_contract.v1.schema.json",
  "title": "Group Visual Contract V1",
  "type": "object",
  "required": ["schema_version", "release_id", "group_count", "groups"],
  "properties": {
    "schema_version": {"const": "group-visual-contract.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "group_count": {"type": "integer", "minimum": 1},
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/group"}
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": ["entity_id", "natural_language", "reason", "evidence"],
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "natural_language": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {"type": "object", "minProperties": 1}
      }
    },
    "group": {
      "type": "object",
      "required": [
        "group_id", "caption_ids", "start", "end", "group_caption_text",
        "narrative_function", "visual_mode", "primary_subjects",
        "supporting_subjects", "event", "event_phase", "location",
        "time_context", "must_show", "may_show", "must_not_show",
        "expected_character_count", "allow_unlisted_narrative_characters",
        "visual_event_state", "group_visual_focus", "caption_contract_bindings",
        "caption_group_sha256"
      ],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "caption_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "start": {"type": "number"},
        "end": {"type": "number"},
        "group_caption_text": {"type": "string"},
        "narrative_function": {"type": "string", "minLength": 1},
        "visual_mode": {"type": "string", "minLength": 1},
        "primary_subjects": {"type": "array", "items": {"type": "string"}},
        "primary_subject_ids": {"type": "array", "items": {"type": "string"}},
        "supporting_subjects": {"type": "array", "items": {"type": "string"}},
        "supporting_subject_ids": {"type": "array", "items": {"type": "string"}},
        "event": {"type": "string"},
        "event_phase": {
          "type": "object",
          "properties": {
            "hard_split_event": {"type": "string"},
            "event_instance_id": {"type": "string"}
          },
          "required": ["hard_split_event", "event_instance_id"],
          "additionalProperties": false
        },
        "location": {"type": "string"},
        "time_context": {"type": "string"},
        "must_show": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "may_show": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "must_not_show": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
        "expected_character_count": {"type": "integer", "minimum": 0},
        "allow_unlisted_narrative_characters": {"type": "boolean"},
        "visual_event_state": {"type": ["object", "null"]},
        "group_visual_focus": {"type": "string"},
        "caption_contract_bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["caption_id", "content_sha256"],
            "properties": {
              "caption_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        },
        "caption_group_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  }
}
