{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Narration Performance Plan v1",
  "description": "M4A expressive narration: performance segments (never per-caption) with delivery mode, emotion, intensity, speed, volume, pitch, pauses and sound tags.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "variant",
    "variant_label",
    "intensity_factor",
    "audio_meta_sha256",
    "voice_profile",
    "segments"
  ],
  "properties": {
    "schema_version": { "const": "narration-performance-plan.v1" },
    "release_id": { "type": "string", "minLength": 1 },
    "variant": { "type": "string", "enum": ["A", "B", "C"] },
    "variant_label": { "type": "string" },
    "intensity_factor": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
    "audio_meta_sha256": { "type": ["string", "null"] },
    "voice_profile": { "type": "object" },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "segment_id", "source_unit_ids", "source_text", "spoken_text",
          "narrative_function", "delivery_mode", "intensity", "speed", "volume",
          "pitch", "pause_before_ms", "pause_after_ms", "sound_tags",
          "performance_note", "estimated_seconds"
        ],
        "properties": {
          "segment_id": { "type": "string" },
          "source_unit_ids": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_text": { "type": "string" },
          "spoken_text": { "type": "string" },
          "narrative_function": { "type": "string" },
          "delivery_mode": { "type": "string", "enum": ["storytelling", "warmth", "tension", "grief", "impact", "reflection"] },
          "emotion": { "type": ["string", "null"], "enum": ["neutral", "calm", "sad", "warm", "tense", "impactful", "reflective", null] },
          "intensity": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "speed": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
          "volume": { "type": "number", "minimum": 0.0, "maximum": 2.0 },
          "pitch": { "type": "number", "minimum": -12.0, "maximum": 12.0 },
          "pause_before_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "pause_after_ms": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "sound_tags": { "type": "array", "maxItems": 2, "items": { "type": "string", "enum": ["sighs", "breath", "inhale", "exhale", "crying"] } },
          "performance_note": { "type": "string" },
          "estimated_seconds": { "type": "number", "minimum": 0.0, "maximum": 120.0 }
        }
      }
    }
  }
}
