{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_spec.book.v2.schema.json",
  "title": "Book HBG Project Specification V2",
  "type": "object",
  "required": ["version", "projectType", "title", "book", "source", "narration", "opening", "workflow", "audio"],
  "properties": {
    "version": {"const": 2},
    "projectType": {"const": "classic-book-narration"},
    "title": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "required": ["chapters"],
      "properties": {"chapters": {"type": "array", "minItems": 1}}
    },
    "narration": {
      "type": "object",
      "required": ["provider", "voice"],
      "properties": {"provider": {"const": "minimax"}, "voice": {"type": "string", "minLength": 1}}
    }
  }
}
