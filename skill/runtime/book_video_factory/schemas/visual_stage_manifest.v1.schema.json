{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_stage_manifest.v1.schema.json",
  "title": "Visual Stage Manifest V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "release_id", "visual_stage_digest", "hbg_bridge_digest",
    "release_text_sha256", "input_sha256", "reference_catalog_sha256", "kernel_sha256",
    "task_counts", "output_hashes", "stage_manifest_path", "stage_manifest_sha256",
    "next_stage_status"
  ],
  "properties": {
    "schema_version": {"const": "visual-stage-manifest.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "visual_stage_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hbg_bridge_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "release_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kernel_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "task_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["anchors", "lookdev", "total"],
      "properties": {
        "anchors": {"type": "integer", "minimum": 1},
        "lookdev": {"const": 12},
        "total": {"type": "integer", "minimum": 13}
      }
    },
    "output_hashes": {"type": "object", "minProperties": 6},
    "stage_manifest_path": {"type": "string", "minLength": 1},
    "stage_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "next_stage_status": {"const": "waiting_for_host_imagegen"}
  }
}
