{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Static Still Plan v1",
  "description": "M4A static-still motion: hold only; zoom/pan/drift/pseudo-camera BLOCKED; every image stays completely static; transitions are hard cuts with rare 6-8 frame dissolves.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "output_size", "motions"],
  "properties": {
    "schema_version": { "const": "simple-zoom-plan.v1" },
    "output_size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "const": 1920 },
        "height": { "const": 1080 }
      }
    },
    "motions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["hold_id", "motion", "zoom", "start", "end", "duration", "rationale"],
        "properties": {
          "hold_id": { "type": "string" },
          "motion": { "type": "string", "const": "hold" },
          "zoom": { "type": "number", "const": 0.0 },
          "start": { "type": "number", "minimum": 0.0 },
          "end": { "type": "number", "minimum": 0.0 },
          "duration": { "type": "number", "minimum": 0.0 },
          "rationale": { "type": "string" }
        }
      }
    }
  }
}
