{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hbg_bridge_input.v1.schema.json",
  "title": "HBG Bridge Input V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "content_package_digest",
    "release_text_sha256",
    "release_id",
    "orientation",
    "brand",
    "narration",
    "chapters",
    "characters",
    "storyboard_beats"
  ],
  "properties": {
    "schema_version": {
      "const": "hbg-bridge-input.v1"
    },
    "content_package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_text_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "orientation": {
      "enum": [
        "landscape",
        "portrait"
      ]
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "series_name",
        "episode_number",
        "lead_text",
        "lead_display_text",
        "reveal_text"
      ],
      "properties": {
        "series_name": {
          "type": "string",
          "minLength": 1
        },
        "episode_number": {
          "type": "integer",
          "minimum": 1
        },
        "lead_text": {
          "type": "string",
          "minLength": 1
        },
        "lead_display_text": {
          "type": "string",
          "minLength": 1
        },
        "reveal_text": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "narration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "voice",
        "body_rate",
        "lead_rate",
        "reveal_rate",
        "pitch"
      ],
      "properties": {
        "provider": {
          "const": "edge-tts"
        },
        "voice": {
          "type": "string",
          "minLength": 1
        },
        "body_rate": {
          "type": "string",
          "pattern": "^[+-]\\d{1,3}%$"
        },
        "lead_rate": {
          "type": "string",
          "pattern": "^[+-]\\d{1,3}%$"
        },
        "reveal_rate": {
          "type": "string",
          "pattern": "^[+-]\\d{1,3}%$"
        },
        "pitch": {
          "type": "string",
          "pattern": "^[+-]\\d{1,3}Hz$"
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "character_id",
          "name",
          "role",
          "life_stage",
          "immutable_traits",
          "changeable_traits",
          "wardrobe",
          "relationships",
          "anchor_status"
        ],
        "properties": {
          "anchor_status": {
            "const": "pending"
          }
        },
        "additionalProperties": true
      }
    },
    "storyboard_beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beat_id",
          "section_id",
          "chapter_id",
          "cue",
          "description",
          "caption_intent",
          "required_entities",
          "forbidden_entities",
          "risk_flags",
          "generation_mode",
          "anchor_refs",
          "participants"
        ],
        "properties": {
          "beat_id": {
            "type": "string",
            "minLength": 1
          },
          "section_id": {
            "type": "string",
            "minLength": 1
          },
          "chapter_id": {
            "type": "string",
            "minLength": 1
          },
          "cue": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "caption_intent": {
            "type": "string",
            "minLength": 1
          },
          "required_entities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "forbidden_entities": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "risk_flags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "hands",
                "phone",
                "tool_use",
                "water_action",
                "animal_contact",
                "body_contact",
                "reflection",
                "death_climax",
                "hero_shot"
              ]
            }
          },
          "generation_mode": {
            "enum": [
              "2x2",
              "single"
            ]
          },
          "anchor_refs": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "participants": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "count",
              "allowed"
            ],
            "properties": {
              "count": {
                "type": "integer",
                "minimum": 0
              },
              "allowed": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
