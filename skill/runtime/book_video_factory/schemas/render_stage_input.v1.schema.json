{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "render_stage_input.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "release_id", "renderer", "output_name", "bgm_source", "opening", "quality", "minimum_free_gib", "hyperframes_version"],
  "properties": {
    "schema_version": {"const": "render-stage-input.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "renderer": {"enum": ["streaming_ffmpeg", "hyperframes"]},
    "output_name": {"type": "string", "pattern": "^[^/\\\\]+\\.mp4$"},
    "bgm_source": {"type": "string", "minLength": 1},
    "opening": {
      "type": "object",
      "required": ["preview_video", "final_image_task_id", "flash_task_ids"],
      "properties": {
        "preview_video": {"type": ["string", "null"]},
        "final_image_task_id": {"type": "string", "minLength": 1},
        "flash_task_ids": {"type": "array", "minItems": 1, "maxItems": 9, "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
      },
      "additionalProperties": false
    },
    "quality": {"enum": ["draft", "standard", "high"]},
    "minimum_free_gib": {"type": "integer", "minimum": 1},
    "hyperframes_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "additionalProperties": false
}
