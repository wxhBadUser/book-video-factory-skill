{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production_image_task.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "task_id", "scene_id", "shot_id", "generation_lane", "generation_mode", "caption_ids", "caption_text", "caption_visual_contract_sha256", "narrative_function", "source_beat_ids", "prompt", "prompt_sha256", "visual_proposition", "prompt_binding", "output_target"],
  "properties": {
    "schema_version": {"const": "production-image-task.v1"},
    "generation_lane": {"const": "host-imagegen"},
    "generation_mode": {"enum": ["single", "2x2"]},
    "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "caption_visual_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "narrative_function": {
      "type": "string",
      "enum": ["opening", "plot", "theory", "author_background", "transition", "closing"]
    },
    "source_beat_ids": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "visual_proposition": {
      "type": "object",
      "required": ["mode", "subject", "action", "environment", "mood", "lighting", "palette", "rationale_text"],
      "properties": {
        "mode": {"enum": ["Literal", "Symbolic", "Abstract"]},
        "subject": {"type": "string", "minLength": 1},
        "action": {"type": "string"},
        "environment": {"type": "string"},
        "mood": {"type": "string", "minLength": 1},
        "lighting": {"type": "string", "minLength": 1},
        "palette": {"type": "string", "minLength": 1},
        "rationale_text": {"type": "string", "minLength": 1},
        "entity_visibility": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["entity_id", "must_be_visible", "natural_language"],
            "properties": {
              "entity_id": {"type": "string", "minLength": 1},
              "must_be_visible": {"type": "boolean"},
              "natural_language": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "surrogate_objects": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "source_terms": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"enum": ["Literal", "Symbolic"]}}, "required": ["mode"]},
          "then": {
            "properties": {
              "action": {"minLength": 1},
              "environment": {"minLength": 1}
            }
          }
        },
        {
          "if": {"properties": {"mode": {"const": "Literal"}}, "required": ["mode"]},
          "then": {"properties": {"entity_visibility": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"mode": {"const": "Symbolic"}}, "required": ["mode"]},
          "then": {"properties": {"surrogate_objects": {"minItems": 1}}}
        }
      ],
      "additionalProperties": false
    },
    "prompt_binding": {
      "type": "object",
      "required": [
        "shot_id",
        "scene_id",
        "group_id",
        "caption_ids",
        "caption_contract_bindings",
        "caption_group_sha256",
        "beat_ids",
        "caption_text_sha256",
        "proposition_sha256",
        "prompt_sha256"
      ],
      "properties": {
        "shot_id": {"type": "string", "minLength": 1},
        "scene_id": {"type": "string", "minLength": 1},
        "group_id": {"type": "string", "minLength": 1},
        "caption_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "caption_contract_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["caption_id", "content_sha256"],
            "properties": {
              "caption_id": {"type": "string", "minLength": 1},
              "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "caption_group_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "caption_visual_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "beat_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "caption_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "proposition_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
