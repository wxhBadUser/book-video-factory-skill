{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual_hold_plan.v1.schema.json",
  "title": "Visual Hold Plan V1",
  "description": "M3.1 production layer between the Group Visual Contract and the Production Image Task. One Visual Hold Segment may contain one or more adjacent Caption Groups; one hold equals one Production Scene Image and one continuous image hold on the timeline.",
  "type": "object",
  "required": [
    "schema_version", "release_id", "hold_count", "group_count", "holds"
  ],
  "properties": {
    "schema_version": {"const": "visual-hold-plan.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "source_grouping_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved": {"type": "boolean"},
    "hold_count": {"type": "integer", "minimum": 1},
    "group_count": {"type": "integer", "minimum": 1},
    "notes": {"type": "array", "items": {"type": "string"}},
    "holds": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/hold"}
    }
  },
  "$defs": {
    "coverage_item": {
      "type": "object",
      "required": ["caption_id", "intended_coverage"],
      "properties": {
        "caption_id": {"type": "string", "minLength": 1},
        "intended_coverage": {"enum": ["DIRECT", "SUPPORTED", "SYMBOLIC"]}
      },
      "additionalProperties": false
    },
    "referent_resolution": {
      "type": "object",
      "required": ["caption_id", "type", "resolved_character_id", "source_caption_id", "evidence"],
      "properties": {
        "caption_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["explicit", "pronoun", "elliptical_subject", "dialogue_speaker", "inherited_visual_subject"]},
        "resolved_character_id": {"type": "string", "minLength": 1},
        "source_caption_id": {"type": "string"},
        "evidence": {"type": "string"}
      },
      "additionalProperties": false
    },
    "hold": {
      "type": "object",
      "required": [
        "hold_id", "start", "end", "duration", "group_ids", "caption_ids",
        "caption_texts", "visual_proposition", "coverage_plan",
        "required_character_instances", "participant_constraint",
        "location", "time_context", "event_state", "merge_reason",
        "referent_resolutions", "persistent_story_characters",
        "anonymous_required_roles", "background_extras_policy"
      ],
      "properties": {
        "hold_id": {"type": "string", "minLength": 1},
        "start": {"type": "number"},
        "end": {"type": "number"},
        "duration": {"type": "number"},
        "group_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "caption_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "caption_texts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "visual_proposition": {"type": "string"},
        "coverage_plan": {"type": "array", "items": {"$ref": "#/$defs/coverage_item"}},
        "required_character_instances": {"type": "array", "items": {"type": "string"}},
        "participant_constraint": {"type": "string"},
        "location": {"type": "string"},
        "time_context": {"type": "string"},
        "event_state": {"type": "string"},
        "merge_reason": {"type": "string"},
        "referent_resolutions": {"type": "array", "items": {"$ref": "#/$defs/referent_resolution"}},
        "persistent_story_characters": {"type": "array", "items": {"type": "string"}},
        "anonymous_required_roles": {"type": "array", "items": {"type": "string"}},
        "background_extras_policy": {"enum": ["", "forbidden", "crowd_allowed", "required"]}
      },
      "additionalProperties": false
    }
  }
}
