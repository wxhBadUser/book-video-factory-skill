{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/schemas/edit_timeline.v2.schema.json",
  "title": "Edit Timeline V2 contract",
  "description": "The resolved render input contract. Every event carries an explicit asset_id plus start/end; the renderer never infers context, holds, or previous assets. Events are contiguous, non-overlapping, cover the full narration, and bind every input document by hash.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "project_id",
    "audio_timeline_sha256",
    "visual_paragraphs_sha256",
    "edit_decisions_sha256",
    "asset_catalog_sha256",
    "narration_duration_seconds",
    "events"
  ],
  "properties": {
    "schema_version": {"const": "edit-timeline.v2"},
    "release_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "audio_timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "visual_paragraphs_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "edit_decisions_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "narration_duration_seconds": {"type": "number", "minimum": 0.0},
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "edit_id",
          "start",
          "end",
          "asset_id",
          "asset_sha256",
          "source_paragraph_ids",
          "transition",
          "motion"
        ],
        "properties": {
          "edit_id": {"type": "string", "minLength": 1},
          "start": {"type": "number", "minimum": 0.0},
          "end": {"type": "number", "minimum": 0.0},
          "asset_id": {"type": "string", "minLength": 1},
          "asset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "source_paragraph_ids": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "transition": {"const": "cut"},
          "motion": {"const": "none"}
        }
      }
    }
  }
}
