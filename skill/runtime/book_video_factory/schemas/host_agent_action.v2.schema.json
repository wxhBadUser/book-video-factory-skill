{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/schemas/host_agent_action.v2.schema.json",
  "title": "Host agent action V2 contract",
  "type": "object",
  "required": [
    "schema_version",
    "action_id",
    "release_id",
    "project_id",
    "action_type",
    "idempotency_key",
    "attempt",
    "inputs",
    "expected_output",
    "max_runtime_seconds"
  ],
  "properties": {
    "schema_version": {"const": "host-agent-action.v2"},
    "action_id": {"type": "string", "minLength": 1},
    "release_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "action_type": {
      "enum": ["plan_visual_covenant", "generate_image", "judge_visual_asset", "select_bgm", "judge_bgm_fit", "plan_literary_director"]
    },
    "idempotency_key": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "asset_id": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1}
        },
        "additionalProperties": true
      }
    },
    "expected_output": {"type": "object"},
    "max_runtime_seconds": {"type": "integer", "minimum": 1}
  },
  "allOf": [
    {
      "if": {
        "properties": {"action_type": {"const": "judge_visual_asset"}},
        "required": ["action_type"]
      },
      "then": {
        "properties": {
          "expected_output": {
            "type": "object",
            "required": [
              "covenant_approval_sha256",
              "visual_paragraph_sha256",
              "judge_policy_sha256",
              "asset_id",
              "asset_sha256"
            ]
          }
        }
      }
    }
  ],
  "additionalProperties": true
}
