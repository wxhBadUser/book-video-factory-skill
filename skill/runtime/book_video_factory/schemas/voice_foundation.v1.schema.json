{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Voice Foundation v1",
  "description": "M4A/M4B MiniMax voice identity: cloned_voice (unused-activation window, verified via Get Voice) or system_voice (verified at runtime).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "provider",
    "voice_strategy",
    "voice_id",
    "model_family",
    "cloned_at",
    "last_used_at",
    "unused_activation_window_hours",
    "source_audio_sha256",
    "prompt_audio_sha256",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": "voice-foundation.v1"
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "const": "minimax"
    },
    "voice_strategy": {
      "type": "string",
      "enum": [
        "cloned_voice",
        "system_voice"
      ]
    },
    "voice_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "model_family": {
      "type": "string"
    },
    "cloned_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "source_audio_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "prompt_audio_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence": {
      "type": "object"
    },
    "last_used_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "unused_activation_window_hours": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2160
    }
  }
}
