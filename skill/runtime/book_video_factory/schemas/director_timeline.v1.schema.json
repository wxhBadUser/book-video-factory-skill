{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "director_timeline.v1.schema.json",
  "type": "object",
  "required": ["schema_version", "release_id", "audio_stage_manifest_sha256", "scene_count", "scenes"],
  "properties": {
    "schema_version": {"const": "director-timeline.v1"},
    "release_id": {"type": "string", "minLength": 1},
    "audio_stage_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "scene_count": {"type": "integer", "minimum": 1},
    "scenes": {"type": "array", "minItems": 1}
  },
  "additionalProperties": true
}
