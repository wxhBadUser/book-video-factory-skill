{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jaxxmind.local/schemas/v2_render_delivery.v2.schema.json",
  "title": "V2 Render Delivery contract",
  "description": "The auto-delivery evidence for the V2 static render. Binds the resolved edit timeline, asset catalog, audio timeline, final video, and passing encoded QA report by hash. It never requires a human approval gate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "project_id",
    "edit_timeline_sha256",
    "asset_catalog_sha256",
    "audio_timeline_sha256",
    "video_path",
    "video_sha256",
    "qa_report_path",
    "qa_report_sha256",
    "auto_delivered",
    "human_approved"
  ],
  "properties": {
    "schema_version": {"const": "render-delivery.v2"},
    "release_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "edit_timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_catalog_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "audio_timeline_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "render_input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "video_path": {"type": "string", "minLength": 1},
    "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "qa_report_path": {"type": "string", "minLength": 1},
    "qa_report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "auto_delivered": {"const": true},
    "human_approved": {"const": false}
  }
}
