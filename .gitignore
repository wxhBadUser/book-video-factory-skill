# ============================================================
# book-video-factory — skill source repo (curated for GitHub)
# Only skill-related SOURCE files are tracked.
# Generated outputs, media, and large binaries are excluded.
# All directory excludes are anchored to repo root ("/") so they
# do NOT match skill/runtime/book_video_factory or skill/scripts.
# ============================================================

# ---- Generated / per-project outputs (never source) ----
/content-input/
/workspace/
/qa/
# NOTE: /qa/ is intentionally excluded from version control. It holds local-only
# runtime policy such as qa/vision_review_provider.json (which vision model
# reviews image evidence). Keeping it out of VCS means a checkout can never
# silently carry an attacker-chosen reviewer; the deployer must supply it, and
# load_vision_review_provider() fails closed when it is missing or untrusted.
/book_video_warehouse/
/FINAL_BLIND_TEST/
/HBG_PARITY_CODEX_UPGRADE_PACK/
/hbg-life-simulation-main.zip
/FINAL_AUDIT_REPORT.md

# ---- Redundant top-level deploy mirror (skill/runtime carries the code) ----
/book_video_factory/

# ---- Top-level dev verification scripts (not part of the skill) ----
/scripts/
/_tmp_*

# ---- Agent local workspace metadata (never source) ----
/.workbuddy/

# ---- Project knowledge docs (supplementary, not the skill) ----
/docs/

# ---- Media / binary (skill repo is text + code + required font) ----
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.webp
*.mp4
*.mov
*.webm
*.mkv
*.avi
*.zip
*.tar.*
*.bin
*.pt
*.onnx
*.ckpt
*.pth
*.wav
*.mp3

# ---- Python cache ----
__pycache__/
*.pyc
*.pyo
*.pytest_cache/
*.egg-info/

# ---- Env / OS / editor ----
.venv/
venv/
env/
/models/
Thumbs.db
.DS_Store
.idea/
.vscode/
*.log
